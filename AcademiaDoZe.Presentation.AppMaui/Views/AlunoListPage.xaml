<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AcademiaDoZe.Presentation.AppMaui.Views.AlunoListPage"
             xmlns:vm="clr-namespace:AcademiaDoZe.Presentation.AppMaui.ViewModels"
             xmlns:dto="clr-namespace:AcademiaDoZe.Application.DTOs;assembly=AcademiaDoZe.Application"
             xmlns:converters="clr-namespace:AcademiaDoZe.Presentation.AppMaui.Converters"
             x:DataType="vm:AlunoListViewModel"
             Title="{Binding Title}">

    <ContentPage.Resources>
        <converters:FotoToImageSourceConverter x:Key="FotoToImageSourceConverter" />
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*">
        <!-- Barra de Filtros e Pesquisa -->
        <Border Grid.Row="0" Style="{StaticResource CardBorder}" Margin="15,10">
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                <Entry Grid.Column="0"
                       Text="{Binding SearchText}"
                       Placeholder="Pesquisar alunos..."
                       ClearButtonVisibility="WhileEditing"
                       ReturnCommand="{Binding SearchAlunosCommand}" />

                <Picker Grid.Column="1"
                        ItemsSource="{Binding FilterTypes}"
                        SelectedItem="{Binding SelectedFilterType}"
                        WidthRequest="110" />

                <Button Grid.Column="2"
                        Command="{Binding SearchAlunosCommand}"
                        Style="{StaticResource ButtonPrimary}"
                        WidthRequest="45"
                        HeightRequest="40"
                        Padding="0">
                    <Button.ImageSource>
                        <FontImageSource FontFamily="MaterialIcons" Glyph="&#xe8b6;" Size="20" />
                    </Button.ImageSource>
                </Button>
            </Grid>
        </Border>

        <!-- Lista com RefreshView e OnIdiom -->
        <RefreshView Grid.Row="1"
                     IsRefreshing="{Binding IsRefreshing}"
                     Command="{Binding RefreshCommand}">
            <CollectionView ItemsSource="{Binding Alunos}" Margin="15,0">
                <CollectionView.ItemsLayout>
                    <GridItemsLayout Orientation="Vertical">
                        <GridItemsLayout.Span>
                            <OnIdiom x:TypeArguments="x:Int32"
                                     Phone="1"
                                     Tablet="2"
                                     Desktop="3" />
                        </GridItemsLayout.Span>
                    </GridItemsLayout>
                </CollectionView.ItemsLayout>

                <CollectionView.EmptyView>
                    <VerticalStackLayout Spacing="10" VerticalOptions="Center" HorizontalOptions="Center" Margin="0,50">
                        <Label Text="&#xe7fd;" FontFamily="MaterialIcons" FontSize="48" HorizontalOptions="Center" TextColor="{StaticResource Gray400}" />
                        <Label Text="Nenhum aluno encontrado" HorizontalOptions="Center" TextColor="{StaticResource Gray400}" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="dto:AlunoDto">
                        <Border Style="{StaticResource CardBorder}" Margin="5">
                            <Grid ColumnDefinitions="80,*" RowDefinitions="Auto,Auto,Auto,Auto" Padding="10" ColumnSpacing="12">
                                <!-- Foto do Aluno -->
                                <Border Grid.Column="0" Grid.RowSpan="4"
                                        WidthRequest="70" HeightRequest="70"
                                        StrokeShape="RoundRectangle 35"
                                        HorizontalOptions="Center" VerticalOptions="Center">
                                    <Image Source="{Binding Foto, Converter={StaticResource FotoToImageSourceConverter}}"
                                           Aspect="AspectFill" />
                                </Border>

                                <Label Grid.Column="1" Grid.Row="0"
                                       Text="{Binding Nome}"
                                       FontAttributes="Bold"
                                       FontSize="16"
                                       LineBreakMode="TailTruncation" />

                                <Label Grid.Column="1" Grid.Row="1"
                                       Text="{Binding Cpf, StringFormat='CPF: {0}'}"
                                       FontSize="13"
                                       TextColor="{StaticResource Gray400}" />

                                <Label Grid.Column="1" Grid.Row="2"
                                       Text="{Binding Telefone, StringFormat='Tel: {0}'}"
                                       FontSize="13"
                                       TextColor="{StaticResource Gray400}" />

                                <!-- Ações: Editar e Excluir -->
                                <HorizontalStackLayout Grid.Column="1" Grid.Row="3" Spacing="10" Margin="0,8,0,0">
                                    <Button Text="Editar"
                                            Clicked="OnEditButtonClicked"
                                            Style="{StaticResource ButtonSecondary}"
                                            HeightRequest="35"
                                            Padding="10,0"
                                            FontSize="12">
                                        <Button.ImageSource>
                                            <FontImageSource FontFamily="MaterialIcons" Glyph="&#xe3c9;" Size="14" />
                                        </Button.ImageSource>
                                    </Button>

                                    <Button Text="Excluir"
                                            Clicked="OnDeleteButtonClicked"
                                            BackgroundColor="#EF4444"
                                            TextColor="White"
                                            HeightRequest="35"
                                            Padding="10,0"
                                            FontSize="12">
                                        <Button.ImageSource>
                                            <FontImageSource FontFamily="MaterialIcons" Glyph="&#xe872;" Size="14" Color="White" />
                                        </Button.ImageSource>
                                    </Button>
                                </HorizontalStackLayout>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>

        <!-- Botão Flutuante: Novo Aluno -->
        <Button Grid.Row="1"
                Command="{Binding AddAlunoCommand}"
                Style="{StaticResource ButtonPrimary}"
                WidthRequest="56"
                HeightRequest="56"
                CornerRadius="28"
                HorizontalOptions="End"
                VerticalOptions="End"
                Margin="20"
                Padding="0">
            <Button.ImageSource>
                <FontImageSource FontFamily="MaterialIcons" Glyph="&#xe145;" Size="24" Color="White" />
            </Button.ImageSource>
        </Button>
    </Grid>
</ContentPage>