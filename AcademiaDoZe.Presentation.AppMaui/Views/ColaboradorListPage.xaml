<?xml version="1.0" encoding="utf-8"?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AcademiaDoZe.Presentation.AppMaui.Views.ColaboradorListPage"
             xmlns:vm="clr-namespace:AcademiaDoZe.Presentation.AppMaui.ViewModels"
             x:DataType="vm:ColaboradorListViewModel"
             xmlns:dto="clr-namespace:AcademiaDoZe.Application.DTOs;assembly=AcademiaDoZe.Application"
             xmlns:converters="clr-namespace:AcademiaDoZe.Presentation.AppMaui.Converters"
             Title="{Binding Title}">

    <ContentPage.Resources>
        <converters:FotoToImageSourceConverter x:Key="FotoToImageSourceConverter" />
        <converters:EnumDisplayConverter x:Key="EnumDisplay" />

        <DataTemplate x:Key="ColaboradorItemTemplate" x:DataType="dto:ColaboradorDto">
            <Grid Padding="5">
                <Border Style="{StaticResource CardBorder}" Margin="0">
                    <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto"
                          ColumnDefinitions="*,Auto,Auto" Padding="12">

                        <!-- Foto com OnIdiom -->
                        <Image Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3"
                               Source="{Binding Foto, Converter={StaticResource FotoToImageSourceConverter}}"
                               Aspect="AspectFill" HorizontalOptions="Center" Margin="0,0,0,10">
                            <Image.HeightRequest>
                                <OnIdiom x:TypeArguments="x:Double">
                                    <OnIdiom.Phone>110</OnIdiom.Phone>
                                    <OnIdiom.Tablet>120</OnIdiom.Tablet>
                                    <OnIdiom.Desktop>120</OnIdiom.Desktop>
                                    <OnIdiom.Default>110</OnIdiom.Default>
                                </OnIdiom>
                            </Image.HeightRequest>
                            <Image.WidthRequest>
                                <OnIdiom x:TypeArguments="x:Double">
                                    <OnIdiom.Phone>110</OnIdiom.Phone>
                                    <OnIdiom.Tablet>120</OnIdiom.Tablet>
                                    <OnIdiom.Desktop>120</OnIdiom.Desktop>
                                    <OnIdiom.Default>110</OnIdiom.Default>
                                </OnIdiom>
                            </Image.WidthRequest>
                        </Image>

                        <!-- Dados Pessoais -->
                        <Label Grid.Row="1" Grid.Column="0" Text="{Binding Nome}" FontAttributes="Bold" FontSize="16" Margin="0,0,0,5" />
                        <Label Grid.Row="2" Grid.Column="0" Text="{Binding Cpf, StringFormat='CPF: {0}'}" Margin="0,0,0,5" />
                        <Label Grid.Row="3" Grid.Column="0" Text="{Binding Telefone, StringFormat='Telefone: {0}'}" Margin="0,0,0,5" />
                        <Label Grid.Row="4" Grid.Column="0" Text="{Binding Email, StringFormat='Email: {0}'}" Margin="0,0,0,5" />
                        <Label Grid.Row="5" Grid.Column="0" Text="{Binding DataNascimento, StringFormat='Nascimento: {0:dd/MM/yyyy}'}" Margin="0,0,0,5" />
                        <Label Grid.Row="6" Grid.Column="0" Text="{Binding DataAdmissao, StringFormat='Admissão: {0:dd/MM/yyyy}'}" Margin="0,0,0,5" />
                        <Label Grid.Row="7" Grid.Column="0" Text="{Binding Tipo, Converter={StaticResource EnumDisplay}, StringFormat='Cargo: {0}'}" Margin="0,0,0,5" />
                        <Label Grid.Row="8" Grid.Column="0" Text="{Binding Vinculo, Converter={StaticResource EnumDisplay}, StringFormat='Vínculo: {0}'}" Margin="0,0,0,5" />

                        <!-- Endereço Formatado -->
                        <Label Grid.Row="9" Grid.Column="0" Margin="0,0,0,5">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="{Binding Endereco.Nome}" />
                                    <Span Text=", " />
                                    <Span Text="{Binding Numero}" />
                                    <Span Text=" - " />
                                    <Span Text="{Binding Endereco.Bairro}" />
                                    <Span Text=", " />
                                    <Span Text="{Binding Endereco.Cidade}" />
                                    <Span Text=" - " />
                                    <Span Text="{Binding Endereco.Estado}" />
                                    <Span Text=" (CEP: " />
                                    <Span Text="{Binding Endereco.Cep}" />
                                    <Span Text=")" />
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>

                        <!-- Botão Editar -->
                        <Button Grid.Row="1" Grid.Column="1" Style="{StaticResource ButtonSmall}" Margin="4,0" Clicked="OnEditButtonClicked">
                            <Button.ImageSource>
                                <FontImageSource FontFamily="MaterialIcons" Glyph="&#xe3c9;" Size="18" />
                            </Button.ImageSource>
                        </Button>

                        <!-- Botão Eliminar -->
                        <Button Grid.Row="1" Grid.Column="2" Style="{StaticResource ButtonDanger}" Margin="4,0" Clicked="OnDeleteButtonClicked">
                            <Button.ImageSource>
                                <FontImageSource FontFamily="MaterialIcons" Glyph="&#xe872;" Size="18" />
                            </Button.ImageSource>
                        </Button>
                    </Grid>
                </Border>
            </Grid>
        </DataTemplate>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*">
        <!-- Barra de Filtros e Pesquisa -->
        <Border Grid.Row="0" Style="{StaticResource CardBorder}" Margin="15,10">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" VerticalOptions="Center">
                <Picker Grid.Column="0" ItemsSource="{Binding FilterTypes}" SelectedItem="{Binding SelectedFilterType}" WidthRequest="110" HeightRequest="40" VerticalOptions="Center" />
                <Entry Grid.Column="1" Text="{Binding SearchText}" Placeholder="Digite o valor..." HeightRequest="40" VerticalOptions="Center" ClearButtonVisibility="WhileEditing" ReturnCommand="{Binding SearchColaboradoresCommand}" />
                <Button Grid.Column="2" Style="{StaticResource ButtonPrimary}" WidthRequest="50" HeightRequest="40" Command="{Binding SearchColaboradoresCommand}">
                    <Button.ImageSource>
                        <FontImageSource FontFamily="MaterialIcons" Glyph="&#xe8b6;" Size="18" />
                    </Button.ImageSource>
                </Button>
            </Grid>
        </Border>

        <!-- Lista Responsiva com OnIdiom -->
        <Grid Grid.Row="1">
            <RefreshView IsRefreshing="{Binding IsRefreshing}" Command="{Binding RefreshCommand}">
                <CollectionView ItemsSource="{Binding Colaboradores}" SelectionMode="None" Margin="10">
                    <CollectionView.ItemsLayout>
                        <GridItemsLayout Orientation="Vertical">
                            <GridItemsLayout.Span>
                                <OnIdiom x:TypeArguments="x:Int32">
                                    <OnIdiom.Phone>1</OnIdiom.Phone>
                                    <OnIdiom.Default>1</OnIdiom.Default>
                                    <OnIdiom.Tablet>2</OnIdiom.Tablet>
                                    <OnIdiom.Desktop>3</OnIdiom.Desktop>
                                    <OnIdiom.TV>4</OnIdiom.TV>
                                </OnIdiom>
                            </GridItemsLayout.Span>
                        </GridItemsLayout>
                    </CollectionView.ItemsLayout>

                    <CollectionView.EmptyView>
                        <StackLayout VerticalOptions="Center">
                            <Label Text="Nenhum colaborador encontrado" HorizontalOptions="Center" Style="{StaticResource SubHeadline}" />
                            <Button Text="Adicionar Primeiro Colaborador" Command="{Binding AddColaboradorCommand}" Style="{StaticResource ButtonPrimary}" HeightRequest="50" Margin="0,20,0,0" />
                        </StackLayout>
                    </CollectionView.EmptyView>

                    <CollectionView.ItemTemplate>
                        <StaticResource Key="ColaboradorItemTemplate" />
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </RefreshView>

            <!-- Botão Flutuante (FAB) -->
            <Button Command="{Binding AddColaboradorCommand}" Style="{StaticResource ButtonPrimary}" WidthRequest="56" HeightRequest="56" HorizontalOptions="End" VerticalOptions="End" Margin="20" CornerRadius="28">
                <Button.ImageSource>
                    <FontImageSource FontFamily="MaterialIcons" Glyph="&#xe145;" Size="24" />
                </Button.ImageSource>
            </Button>
        </Grid>

        <ActivityIndicator Grid.Row="0" Grid.RowSpan="2" IsVisible="{Binding IsBusy}" IsRunning="{Binding IsBusy}" VerticalOptions="Center" HorizontalOptions="Center" />
    </Grid>
</ContentPage>